# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# For db:migrate - get from Dashboard → Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Solana
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=REPLACE_WITH_YOUR_PROGRAM_ID
# Devnet USDC: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU | Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_TREASURY_WALLET=your_treasury_wallet_address

# Privy (embedded wallets + auth)
# App ID: https://dashboard.privy.io/ → your app
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
# Keep false to avoid extension/content-script host validation issues.
# Set true only if you intentionally want external Solana wallet connectors.
NEXT_PUBLIC_ENABLE_EXTERNAL_SOLANA_WALLETS=false
# App Secret: Dashboard → App settings (for server-side token verification)
PRIVY_APP_SECRET=your_privy_app_secret
# Optional: JWKS URL (default: https://auth.privy.io/api/v1/apps/<APP_ID>/jwks.json)
# PRIVY_JWKS_URI=https://auth.privy.io/api/v1/apps/your_app_id/jwks.json

# Stripe Crypto Onramp (primary card → USDC → escrow vault)
STRIPE_SECRET_KEY=sk_test_or_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_...
STRIPE_CRYPTO_ONRAMP_VERSION=2026-01-28.clover
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ONRAMP_MAX_USD=250

# Payment feature flags
NEXT_PUBLIC_PAYMENT_PROVIDER=hybrid
NEXT_PUBLIC_ENABLE_STRIPE_ONRAMP=true
NEXT_PUBLIC_ENABLE_PRIVY_CARD_FALLBACK=true
NEXT_PUBLIC_ENABLE_BLINK_FALLBACK=true
NEXT_PUBLIC_STRIPE_ALLOW_DEVNET=false

# Coinbase (pay with card / onramp)
# From https://portal.cdp.coinbase.com/ → API Keys (create key with Onramp scope)
COINBASE_CDP_API_KEY_ID=your_cdp_api_key_id
COINBASE_CDP_API_KEY_SECRET=your_cdp_api_key_secret

# Backend Hot Wallet (V1 only - for release signing)
HOT_WALLET_PRIVATE_KEY=5YxDrcqSf4j7e6cxeWfMSrs4akNyV73ZpTP7bLQ4Acub6jgnwXGSGuS998KC8o8wcWW5MXDp6LyxsquX5TBLVu1e

# Debug only: skip on-chain release call after password/base58 validation.
# Never enable this in normal production operation.
BYPASS_RELEASE_APPROVALS_FOR_DEBUG=false

# Worker authorization secret for /api/workers/reconcile-invoices
WORKER_CRON_SECRET=replace_with_worker_secret

# Admin panel/API secret for /admin and /api/admin/activity or ticket updates
ADMIN_PANEL_SECRET=replace_with_admin_secret

# Optional: webhook endpoint for invoice state change notifications (email/push worker).
# Receives POST JSON payload: { type, occurredAt, invoice, transition }.
STATE_CHANGE_WEBHOOK_URL=
